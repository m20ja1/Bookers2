<h1>Log in</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with url: session_path do |f| %>
    <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, required: true, autofocus: true %>
    </div>

    <div class="field">
    <%= f.label :password %><br>
    <%= f.password_field :password, required: true %>
    </div>

    <div class="field">
    <%= f.check_box :remember_me %>
    <%= f.label :remember_me, "Remember me" %>
    </div>

    <div class="actions">
      <%= f.submit "Log in", class: "btn btn-sm btn-primary" %>
    </div>

<% end %>

<%= link_to 'Sign up', new_user_path, class: "link-offset-0 link-offset-0-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" %><br>